# HTTP port. The MusicDown app and the Spicetify extension default to 3008.
PORT=3008

# Access key (required if the server is reachable from the internet). Any long random string.
# The app and the Spicetify extension send it in the "x-api-key" header.
# In the app: Settings -> Access key. Leave empty to disable authentication (local network only).
ACCESS_KEY=change-me-to-a-long-random-string

# Optional: binary paths when they are not on PATH.
# YTDLP_PATH=
# FFMPEG_PATH=
# CLOUDFLARED_PATH=

# Optional: YouTube player client passed to yt-dlp. Default: web_embedded. Empty = yt-dlp default.
# YT_PLAYER_CLIENT=web_embedded

# Optional: data locations (default: ./data).
# SPOTIFY_LIKES_FILE=./data/spotify-likes.json
# LIBRARY_BACKUP_FILE=./data/library-backup.json
# STREAM_CACHE_DIR=./data/stream-cache
# STREAM_CACHE_MAX_FILES=60
