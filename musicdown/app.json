{
  "expo": {
    "name": "MusicDown",
    "slug": "musicdown",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.musicdown.app",
      "adaptiveIcon": {
        "backgroundColor": "#14212B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "musicdown",
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "audio"
          ]
        }
      ],
      "expo-image-picker",
      "expo-audio",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14212B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/fraunces/600SemiBold/Fraunces_600SemiBold.ttf"
          ],
          "widgets": [
            {
              "name": "NowPlayingMini",
              "label": "MusicDown · Fila 4×1",
              "description": "Carátula, canción y controles en una fila",
              "minWidth": "250dp",
              "minHeight": "56dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 0
            },
            {
              "name": "NowPlayingMiniSemi",
              "label": "MusicDown · Fila 4×1 semitraslúcida",
              "description": "Fila con fondo semitraslúcido",
              "minWidth": "250dp",
              "minHeight": "56dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 0
            },
            {
              "name": "NowPlayingMiniClear",
              "label": "MusicDown · Fila 4×1 transparente",
              "description": "Fila con fondo transparente",
              "minWidth": "250dp",
              "minHeight": "56dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 0
            },
            {
              "name": "NowPlaying",
              "label": "MusicDown · Medio 4×2",
              "description": "Carátula grande y controles",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 0
            },
            {
              "name": "NowPlayingSemi",
              "label": "MusicDown · Medio 4×2 semitraslúcido",
              "description": "Medio con fondo semitraslúcido",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 0
            },
            {
              "name": "NowPlayingClear",
              "label": "MusicDown · Medio 4×2 transparente",
              "description": "Medio con fondo transparente",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 0
            },
            {
              "name": "NowPlayingCover",
              "label": "MusicDown · Portada 4×2",
              "description": "Carátula a pantalla completa con controles",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 0
            },
            {
              "name": "NowPlayingCoverBig",
              "label": "MusicDown · Portada 4×4",
              "description": "Portada grande con controles",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            },
            {
              "name": "NowPlayingSquare",
              "label": "MusicDown · Cuadrado 2×2",
              "description": "Carátula con controles",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "updatePeriodMillis": 0
            }
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2134217c-6474-48e6-8bf7-56bcdb3c1ef2"
      }
    }
  }
}
